    {
      "id": "AP-11",
      "title": "Read-only role cannot create an appointment",
      "path": "/v2/bookings",
      "status": 403,
      "method": "POST",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"READ_ONLY_ROLE\""
      },
      "body": {
        "eventTypeId": 10,
        "start": "2030-01-07T09:00:00.000Z",
        "attendee": {
          "name": "Synthetic Patient One",
          "email": "patient-a@example.test",
          "timeZone": "Asia/Karachi",
          "language": "en"
        },
        "bookingFieldsResponses": {
          "patientReference": "SYNTH-01"
        }
      },
      "headers": {
        "Authorization": "Bearer fixture-reader",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-12",
      "title": "Reject missing attendee",
      "path": "/v2/bookings",
      "status": 422,
      "method": "POST",
