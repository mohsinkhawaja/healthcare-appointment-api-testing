    {
      "id": "AP-10",
      "title": "Reject unknown event type availability",
      "path": "/v2/slots?eventTypeId=99&start=2030-01-07&end=2030-01-08",
      "status": 404,
      "method": "GET",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"EVENT_TYPE_NOT_FOUND\""
