{
  "name": "Synthetic clinic scheduling contract",
  "description": "Single-provider, capacity-one appointment model with a fixed reference clock.",
  "variables": {},
  "cases": [
    {
      "id": "AP-01",
      "title": "Reject missing authorization",
      "path": "/v2/bookings",
      "status": 401,
      "method": "GET",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"AUTH_REQUIRED\""
      },
      "headers": {},
      "cookieJar": false
    },
    {
      "id": "AP-02",
      "title": "Reject invalid bearer",
      "path": "/v2/bookings",
      "status": 401,
      "method": "GET",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"AUTH_REQUIRED\""
      },
      "headers": {
        "Authorization": "Bearer invalid",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-03",
      "title": "Reject incorrect API version",
      "path": "/v2/bookings",
      "status": 400,
      "method": "GET",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"WRONG_API_VERSION\""
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "1999-01-01"
      },
      "cookieJar": false
    },
    {
      "id": "AP-04",
      "title": "List initially empty appointments",
      "path": "/v2/bookings",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "Array.isArray(data.data) && data.data.length === 0"
      },
      "headers": {
        "Authorization": "Bearer fixture-reader",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-05",
      "title": "Read provider availability in a valid date window",
      "path": "/v2/slots?eventTypeId=10&start=2030-01-07&end=2030-01-08",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data[\"2030-01-07\"].length === 3"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2024-09-04"
      },
      "cookieJar": false
    },
    {
      "id": "AP-06",
      "title": "Ignore out-of-window slots",
      "path": "/v2/slots?eventTypeId=10&start=2030-01-08&end=2030-01-09",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "Object.keys(data.data).length === 0"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2024-09-04"
      },
      "cookieJar": false
    },
