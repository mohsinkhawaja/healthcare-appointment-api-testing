    {
      "id": "AP-17",
      "title": "Create booking from an offset equivalent to UTC",
      "path": "/v2/bookings",
      "status": 201,
      "method": "POST",
      "assertions": {
        "contract conditions": "data.data.status === \"accepted\" && data.data.start === \"2030-01-07T09:00:00.000Z\" && data.data.end === \"2030-01-07T09:30:00.000Z\""
      },
      "body": {
        "eventTypeId": 10,
        "start": "2030-01-07T14:00:00+05:00",
        "attendee": {
          "name": "Synthetic Patient One",
          "email": "patient-a@example.test",
          "timeZone": "Asia/Karachi",
          "language": "en"
        },
        "bookingFieldsResponses": {
          "patientReference": "SYNTH-01"
        }
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "capture": {
        "firstUid": "data.data.uid"
      },
      "cookieJar": false
    },
    {
      "id": "AP-18",
      "title": "Read booking by captured UID",
      "path": "/v2/bookings/{{firstUid}}",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data.uid === get(\"firstUid\") && data.data.duration === 30"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-19",
      "title": "Booking consumes the corresponding slot",
      "path": "/v2/slots?eventTypeId=10&start=2030-01-07&end=2030-01-08",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data[\"2030-01-07\"].length === 2 && data.data[\"2030-01-07\"].every(s => s.start !== \"2030-01-07T09:00:00.000Z\")"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2024-09-04"
      },
      "cookieJar": false
    },
    {
      "id": "AP-20",
      "title": "Different offset spelling for same instant conflicts",
      "path": "/v2/bookings",
      "status": 409,
      "method": "POST",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"SLOT_TAKEN\""
      },
      "body": {
        "eventTypeId": 10,
        "start": "2030-01-07T09:00:00.000Z",
