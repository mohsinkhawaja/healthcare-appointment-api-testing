      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "capture": {
        "adjacentUid": "data.data.uid"
      },
      "cookieJar": false
    },
    {
      "id": "AP-22",
      "title": "Reject reschedule into occupied slot",
      "path": "/v2/bookings/{{firstUid}}/reschedule",
      "status": 409,
      "method": "POST",
      "assertions": {
        "stable error rule": "data.status === \"error\" && data.error.code === \"SLOT_TAKEN\""
      },
      "body": {
        "start": "2030-01-07T09:30:00.000Z"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-23",
      "title": "Failed reschedule preserves original booking",
      "path": "/v2/bookings/{{firstUid}}",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data.status === \"accepted\" && data.data.start === \"2030-01-07T09:00:00.000Z\""
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-24",
      "title": "Reschedule to free slot",
      "path": "/v2/bookings/{{firstUid}}/reschedule",
      "status": 201,
      "method": "POST",
      "assertions": {
        "contract conditions": "data.data.start === \"2030-01-07T10:00:00.000Z\" && data.data.uid !== get(\"firstUid\") && data.data.rescheduledFromUid === get(\"firstUid\")"
      },
      "body": {
        "start": "2030-01-07T10:00:00.000Z"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "capture": {
        "replacementUid": "data.data.uid"
      },
      "cookieJar": false
    },
    {
      "id": "AP-25",
      "title": "Original booking links to replacement",
      "path": "/v2/bookings/{{firstUid}}",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data.status === \"cancelled\" && data.data.rescheduledToUid === get(\"replacementUid\")"
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2026-02-25"
      },
      "cookieJar": false
    },
    {
      "id": "AP-26",
      "title": "Original slot is offered again",
      "path": "/v2/slots?eventTypeId=10&start=2030-01-07&end=2030-01-08",
      "status": 200,
      "method": "GET",
      "assertions": {
        "contract conditions": "data.data[\"2030-01-07\"].length === 1 && data.data[\"2030-01-07\"][0].start === \"2030-01-07T09:00:00.000Z\""
      },
      "headers": {
        "Authorization": "Bearer fixture-scheduler",
        "cal-api-version": "2024-09-04"
      },
      "cookieJar": false
    },
