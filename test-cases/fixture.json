    {
      "id": "AP-21",
      "title": "Accept booking at immediately adjacent slot",
      "path": "/v2/bookings",
      "status": 201,
      "method": "POST",
      "assertions": {
        "contract conditions": "data.data.start === \"2030-01-07T09:30:00.000Z\" && data.data.end === \"2030-01-07T10:00:00.000Z\""
      },
      "body": {
        "eventTypeId": 10,
        "start": "2030-01-07T09:30:00.000Z",
        "attendee": {
          "name": "Synthetic Patient One",
          "email": "patient-a@example.test",
          "timeZone": "Asia/Karachi",
          "language": "en"
        },
        "bookingFieldsResponses": {
          "patientReference": "SYNTH-02"
