        "stable error rule": "data.status === \"error\" && data.error.code === \"SLOT_OUTSIDE_SCHEDULE\""
      },
      "body": {
        "eventTypeId": 10,
        "start": "2030-01-07T09:01:00Z",
        "attendee": {
          "name": "Synthetic Patient One",
          "email": "patient-a@example.test",
          "timeZone": "Asia/Karachi",
          "language": "en"
